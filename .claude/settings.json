{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "enableAllProjectMcpServers": false,
  "enabledMcpjsonServers": ["angular-cli"],
  "permissions": {
    "allow": [
      "mcp__angular-cli",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git branch --show-current)",
      "Bash(node scripts/check-okf.mjs*)",
      "Bash(npx ng lint*)",
      "Bash(npx ng test*)",
      "Bash(npx ng build*)",
      "Bash(npx playwright test*)"
    ],
    "ask": [
      "Bash(git push*)",
      "Bash(gh pr create*)",
      "Bash(gh pr merge*)",
      "Bash(git credential*)"
    ],
    "deny": [
      "Skill(kup-archiwum)",
      "Bash(*kup-pre-push*)",
      "Bash(*SVN_50KUP*)",
      "Read(./.env)",
      "Read(./.env.*)"
    ]
