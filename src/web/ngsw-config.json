{
  "$schema": "./node_modules/@angular/service-worker/config/schema.json",
  "index": "/index.html",
  "assetGroups": [
    {
      "name": "app",
      "installMode": "prefetch",
      "resources": {
        "files": ["/index.html", "/manifest.webmanifest", "/*.css", "/*.js", "/i18n/*.json"]
      }
    },
    {
      "name": "assets",
      "installMode": "lazy",
      "updateMode": "prefetch",
      "resources": {
        "files": ["/icons/*.png", "/**/*.(svg|jpg|jpeg|png|webp|avif|woff2)"]
      }
    },
    {
      "name": "vision",
      "installMode": "lazy",
      "updateMode": "lazy",
      "resources": {
        "files": ["/mediapipe/*", "/models/*"]
      }
    }
  ]
}
