{
  "name": "blinker-web",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test --watch=false",
    "test:watch": "ng test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "e2e": "ng build && npm run design:build && playwright test",
    "e2e:only": "playwright test",
    "lint": "ng lint",
    "test:scripts": "node --test \"scripts/*.test.mjs\"",
    "check:dist": "node scripts/check-dist.mjs",
    "design:build": "node scripts/build-design.mjs",
    "design:serve": "node scripts/build-design.mjs && node scripts/serve-design.mjs",
    "lighthouse": "node scripts/lighthouse.mjs",
    "verify": "node scripts/verify.mjs",
    "hooks:install": "git config --local core.hooksPath .githooks",
    "icons": "node scripts/generate-icons.mjs"
  },
  "private": true,
  "packageManager": "npm@11.19.0",
  "dependencies": {
    "@angular/cdk": "^22.2.7",
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/material": "^22.2.7",
    "@angular/platform-browser": "^22.2.0",
    "@angular/router": "^22.2.0",
    "@angular/service-worker": "^22.2.0",
    "@jsverse/transloco": "8.4.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.6",
    "@angular/cli": "^22.2.6",
    "@angular/compiler-cli": "^22.2.0",
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "^10.0.1",
    "@lhci/cli": "0.16.0",
    "@playwright/test": "1.65.0",
    "@tailwindcss/postcss": "4.3.5",
    "angular-eslint": "22.6.0",
    "eslint": "^10.12.0",
    "eslint-plugin-no-unsanitized": "4.1.5",
    "jsdom": "^31.0.0",
    "postcss": "8.5.32",
    "prettier": "^3.8.1",
    "tailwindcss": "4.3.5",
    "typescript": "~6.0.2",
    "typescript-eslint": "8.72.1",
    "vitest": "^5.0.0"
  },
  "engines": {
    "node": ">=26"
  },
  "overrides": {
    "basic-ftp": "6.2.6",
    "minimatch@>=7.0.0 <11.0.1": "11.0.8"
  }
}
